/* Проверка типов стенда API-тестов и вспомогательного кода: запускается из `pnpm test:api`. */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "types": ["node"]
    },
    "files": [],
    "include": [
        "tests/**/*.ts",
        "vitest.api.config.mts",
        "vitest.integration.config.mts",
        "vitest.lint.config.mts",
        "proxy.conf.mjs"
    ]
}
