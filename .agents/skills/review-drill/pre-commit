#!/bin/sh
# review-drill: блокирует коммит, пока идёт тренировка ревью (удаляется при её завершении).
if [ -d "$(git rev-parse --git-dir)/review-drill" ]; then
    echo "review-drill: тренировка ревью не завершена, внедрённые дефекты ещё в коде." >&2
    echo "Найди их или скажи агенту «сдаюсь» — тогда он откатит дефекты и снимет блокировку." >&2
    exit 1
fi
