{
    "name": "pchelpcrm",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:api": "tsc -p tsconfig.tests.json && vitest run --config vitest.api.config.mts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "serve:ssr:pchelpcrm": "node dist/pchelpcrm/server/server.mjs",
        "pb:serve": "pocketbase serve --dir pocketbase/pb_data --migrationsDir pocketbase/pb_migrations --dev",
        "pb:superuser": "node --env-file=.env scripts/pb-superuser.mjs",
        "pb:migrate": "pocketbase migrate up --dir pocketbase/pb_data --migrationsDir pocketbase/pb_migrations"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.2.0",
        "@angular/compiler": "^22.2.0",
        "@angular/core": "^22.2.0",
        "@angular/forms": "^22.2.0",
        "@angular/platform-browser": "^22.2.0",
        "@angular/platform-server": "^22.2.0",
        "@angular/router": "^22.2.0",
        "@angular/ssr": "^22.2.3",
        "express": "^5.1.0",
        "pocketbase": "^0.28.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.3",
        "@angular/cli": "^22.2.3",
        "@angular/compiler-cli": "^22.2.0",
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.1",
        "@types/node": "^22.12.0",
        "angular-eslint": "^22.6.0",
        "eslint": "^10.13.0",
        "jsdom": "^30.0.0",
        "prettier": "^3.8.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.0"
    }
}
